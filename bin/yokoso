#!/bin/sh
# yokoso: a greetd greeter on Quickshell.
#
#   yokoso           as greetd's greeter: cage on the GPU that drives the screens
#   yokoso preview   a window in the current Wayland session, logging in against
#                    greetd's fakegreet (password "password", then "9")
#   yokoso shot <png>  development: render headless and save a screenshot
#
# Before anything draws, this takes a snapshot for the QML side (screens with
# their physical size, sessions, users) and keeps the stack on the GPU that
# drives the screens, so an idle discrete GPU stays asleep.
set -eu

mode=${1:-greeter}

# The backlights' levels from before yokoso dimmed the screen, kept while it
# is dim: if yokoso stops before waking it, they're set back here, so that
# neither agreety nor the next boot (systemd-backlight saves the level at
# shutdown) starts dim. Only the greeter's session may set them.
restore_backlight() {
	[ "$mode" = greeter ] && [ -s "${YOKOSO_BACKLIGHT:-}" ] || return 0
	jq -r 'to_entries[] | "\(.key) \(.value)"' "$YOKOSO_BACKLIGHT" 2>/dev/null |
		while read -r name level; do
			busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
				org.freedesktop.login1.Session SetBrightness ssu backlight "$name" "$level" || true
		done
	: >"$YOKOSO_BACKLIGHT"
}

# As greetd's greeter, any failure (here, in cage or in Quickshell) falls back
# to greetd's text greeter, so a broken yokoso doesn't lock anyone out. It
# logs in to the session yokoso would have started, or the user's shell.
fallback() {
	trap - EXIT
	set +eu
	echo "yokoso failed (journalctl -b -t yokoso), falling back to agreety" >&2
	restore_backlight
	config=$(jq -c 'objects' "${YOKOSO_CONFIG:-/etc/yokoso/config.json}" 2>/dev/null)
	[ -n "$config" ] || config={}
	cmd=$(jq -r --argjson config "$config" '
		($config.session // "") as $want
		| [(.sessions[] | select(.id == $want or .id == "\($want).desktop")), .sessions[]][0] // empty
		| if .type == "x11" then "\($config.x11Wrapper // "startx /usr/bin/env") \(.exec)" else .exec end
		' "$run_dir/env.json" 2>/dev/null)
	exec agreety --cmd "${cmd:-\$SHELL}"
}
if [ "$mode" = greeter ]; then
	trap '[ $? = 0 ] || fallback' EXIT
fi

here=$(cd "$(dirname "$0")" && pwd)
shell_dir=${YOKOSO_SHELL_DIR:-$here/../share/yokoso/shell}
run_dir=${XDG_RUNTIME_DIR:-/tmp}/yokoso
mkdir -p "$run_dir"
export YOKOSO_CONFIG="${YOKOSO_CONFIG:-/etc/yokoso/config.json}"
export YOKOSO_BACKLIGHT="$run_dir/backlight.json"
# From a greeter before this one that didn't get to it.
restore_backlight

# GPUs with a connected connector; the boot VGA device if none has one.
cards() {
	for card in /sys/class/drm/card[0-9]*; do
		case ${card##*/} in *-*) continue ;; esac
		echo "${card##*/}"
	done
}
display_cards=
for card in $(cards); do
	for conn in "/sys/class/drm/$card"-*; do
		if [ "$(cat "$conn/status" 2>/dev/null)" = connected ]; then
			display_cards="$display_cards $card"
			break
		fi
	done
done
if [ -z "$display_cards" ]; then
	for card in $(cards); do
		[ "$(cat "/sys/class/drm/$card/device/boot_vga" 2>/dev/null)" = 1 ] && display_cards=$card
	done
fi

drm_devices=
render_node=
uses_nvidia=false
for card in $display_cards; do
	drm_devices=${drm_devices:+$drm_devices:}/dev/dri/$card
	[ "$(basename "$(readlink -f "/sys/class/drm/$card/device/driver")")" = nvidia ] && uses_nvidia=true
	for r in "/sys/class/drm/$card/device/drm/"renderD*; do
		[ -z "$render_node" ] && [ -e "$r" ] && render_node=/dev/dri/${r##*/}
	done
done

# With no screen on an NVIDIA GPU, only Mesa's EGL is offered: libglvnd would
# otherwise load NVIDIA's first, which wakes the GPU from D3cold and costs
# about two seconds before the first frame.
if [ "$uses_nvidia" = false ]; then
	for f in /run/opengl-driver/share/glvnd/egl_vendor.d/*mesa*.json \
		/etc/glvnd/egl_vendor.d/*mesa*.json /usr/share/glvnd/egl_vendor.d/*mesa*.json; do
		if [ -e "$f" ]; then
			export __EGL_VENDOR_LIBRARY_FILENAMES="$f"
			break
		fi
	done
fi

# Connected screens and the physical size their EDID gives (first detailed
# timing, else the basic block's centimetres; 0 when unknown).
screens_json() {
	for card in $display_cards; do
		for conn in "/sys/class/drm/$card"-*; do
			[ "$(cat "$conn/status" 2>/dev/null)" = connected ] || continue
			name=${conn##*/}
			od -An -tu1 -v "$conn/edid" 2>/dev/null | awk -v name="${name#"$card"-}" '
				{ for (i = 1; i <= NF; i++) b[n++] = $i }
				END {
					w = 0; h = 0
					if (n >= 128 && (b[54] || b[55])) {
						w = b[66] + int(b[68] / 16) * 256
						h = b[67] + (b[68] % 16) * 256
					}
					if ((w < 50 || h < 50) && n >= 128) { w = b[21] * 10; h = b[22] * 10 }
					if (w < 50 || h < 50 || w > 3000 || h > 3000) { w = 0; h = 0 }
					printf "{\"name\":\"%s\",\"widthMm\":%d}\n", name, w
				}'
		done
	done | jq -s .
}

# Session entries (the first of each file name and type), Wayland's before
# X11's, as id, name, exec, desktop names and type. YOKOSO_SESSION_DIRS
# overrides the directories; those named xsessions hold X11 ones.
sessions_json() {
	dirs=${YOKOSO_SESSION_DIRS:-}
	if [ -z "$dirs" ]; then
		IFS=:
		for kind in wayland-sessions xsessions; do
			for d in ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
				dirs="$dirs:$d/$kind"
			done
		done
		unset IFS
	fi
	IFS=:
	for d in $dirs; do
		case $d in */xsessions) type=x11 ;; *) type=wayland ;; esac
		for f in "$d"/*.desktop; do
			[ -e "$f" ] || continue
			awk -v id="${f##*/}" -v type="$type" -F= '
				/^\[/ { entry = ($0 == "[Desktop Entry]"); next }
				entry && !($1 in v) { k = $1; sub(/^[^=]*=/, ""); v[k] = $0 }
				END {
					if (v["Hidden"] == "true" || v["NoDisplay"] == "true" || v["Exec"] == "") exit
					print id; print v["Name"]; print v["Exec"]; print v["DesktopNames"]; print type
				}' "$f"
		done
	done | jq -R . | jq -s '
		[range(0; length; 5) as $i | .[$i:$i + 5]
			| {id: .[0], name: .[1], exec: .[2], desktopNames: .[3], type: .[4]}]
		| reduce .[] as $s ([]; if any(.[]; .id == $s.id and .type == $s.type) then . else . + [$s] end)'
	unset IFS
}

# Login accounts, from NSS so that systemd-homed's (UIDs 60001..60513) are
# there too: UID_MIN..UID_MAX from login.defs, with a real shell. Each with
# a picture, if the greeter can read one: avatars/<name> next to the
# config, else AccountsService's. Not ~/.face: homes are rarely readable,
# and a network one would hold up the login screen.
users_json() {
	min=$(awk '$1 == "UID_MIN" { print $2 }' /etc/login.defs 2>/dev/null)
	max=$(awk '$1 == "UID_MAX" { print $2 }' /etc/login.defs 2>/dev/null)
	{ getent passwd 2>/dev/null || cat /etc/passwd; } | awk -F: -v min="${min:-1000}" -v max="${max:-60000}" '
		($3 >= min && $3 <= max || $3 >= 60001 && $3 <= 60513) && $7 !~ /(nologin|false)$/ && !seen[$1]++ {
			real = $5; sub(/,.*/, "", real)
			print $1; print (real == "" ? $1 : real)
		}' | while IFS= read -r name && IFS= read -r real; do
		icon=
		for f in "${YOKOSO_CONFIG%/*}/avatars/$name" "/var/lib/AccountsService/icons/$name"; do
			[ -f "$f" ] && [ -r "$f" ] && icon=$f && break
		done
		printf '%s\n%s\n%s\n' "$name" "$real" "$icon"
	done | jq -R . | jq -s '[range(0; length; 3) as $i | {name: .[$i], realName: .[$i + 1], icon: .[$i + 2]}]'
}

# The theme: config.theme ("dark", "light", the name of a file in themes/
# next to the config, or a file's path), on top of what it extends, and
# that on top of the built-in dark one. Paths in a theme are relative to
# its file. A theme that can't be read is skipped, with a warning.
theme_json() {
	base=$shell_dir/themes/dark.json
	ref=$(jq -r '.theme // "dark"' "$YOKOSO_CONFIG" 2>/dev/null) || ref=dark
	theme='{}'
	depth=0
	while [ "$depth" -lt 8 ]; do
		case $ref in
		/*) file=$ref ;;
		*)
			file=${YOKOSO_CONFIG%/*}/themes/$ref.json
			[ -e "$file" ] || file=$shell_dir/themes/$ref.json
			;;
		esac
		[ "$file" = "$base" ] && break
		if layer=$(jq -ce --arg dir "${file%/*}" '
			objects
			| def resolve: if type == "string" and . != "" and (startswith("/") | not) then "\($dir)/\(.)" else . end;
			if .background | type == "object" then .background |= map_values(resolve)
			else .background |= resolve end
			| if .background == null then del(.background) else . end
			| if .look == null then . else .look |= resolve end' "$file" 2>/dev/null); then
			theme=$(jq -nc --argjson low "$layer" --argjson high "$theme" '$low * $high')
			ref=$(jq -nr --argjson layer "$layer" '$layer.extends // "dark"')
		else
			echo "yokoso: can't read the theme $ref ($file), using dark" >&2
			ref=dark
		fi
		depth=$((depth + 1))
	done
	jq -c --argjson high "$theme" '. * $high | del(.extends)' "$base"
}

# The power actions logind allows us, in the buttons' order.
power_json() {
	for action in Suspend:suspend Reboot:reboot PowerOff:poweroff; do
		[ "$(busctl call org.freedesktop.login1 /org/freedesktop/login1 \
			org.freedesktop.login1.Manager "Can${action%:*}" 2>/dev/null)" = 's "yes"' ] &&
			echo "${action#*:}"
	done | jq -R . | jq -s .
}

# The lid's state file, on laptops, and the keyboards' Caps Lock LEDs.
lid=
for f in /proc/acpi/button/lid/*/state; do
	[ -e "$f" ] && lid=$f && break
done
caps_leds=$(for f in /sys/class/leds/*::capslock/brightness; do
	[ -e "$f" ] && echo "$f"
done | jq -R . | jq -s .)

# The machine's battery, not a mouse's or a keyboard's (their scope is
# "Device").
battery=
for d in /sys/class/power_supply/*; do
	if [ "$(cat "$d/type" 2>/dev/null)" = Battery ] && [ "$(cat "$d/scope" 2>/dev/null)" != Device ] &&
		[ "$(cat "$d/present" 2>/dev/null || echo 1)" = 1 ]; then
		battery=$d
		break
	fi
done

# Backlights, to dim when idle, but not an NVIDIA GPU's while it drives no
# screen: reading one would wake the GPU.
backlights=$(for b in /sys/class/backlight/*; do
	[ -e "$b/max_brightness" ] || continue
	dev=$(readlink -f "$b/device")
	nvidia=false
	while [ "$dev" != /sys/devices ] && [ "${dev#/sys/devices/}" != "$dev" ]; do
		[ "$(basename "$(readlink -f "$dev/driver")")" = nvidia ] && nvidia=true
		dev=${dev%/*}
	done
	[ "$nvidia" = true ] && [ "$uses_nvidia" = false ] && continue
	printf '{"name":"%s","max":%d}\n' "${b##*/}" "$(cat "$b/max_brightness")"
done | jq -s .)

# The system's locale, for the date and yokoso's words, which greetd
# doesn't pass on.
locale_conf() {
	sed -n "s/^$1=[\"']\{0,1\}\([^\"']*\).*/\1/p" /etc/locale.conf 2>/dev/null | tail -n 1
}
export LANG="${LANG:-$(locale_conf LANG)}" LC_TIME="${LC_TIME:-$(locale_conf LC_TIME)}" \
	LC_MESSAGES="${LC_MESSAGES:-$(locale_conf LC_MESSAGES)}"

# yokoso's own words in config.language, else the locale's language, from
# i18n/<language>.json next to the QML; English needs none.
strings_json() {
	language=$(jq -r '.language // empty' "$YOKOSO_CONFIG" 2>/dev/null)
	locale=${LC_ALL:-${LC_MESSAGES:-$LANG}}
	language=${language:-${locale%%[_.@]*}}
	jq -c 'objects' "$shell_dir/i18n/$language.json" 2>/dev/null || echo '{}'
}

jq -n --argjson screens "$(screens_json)" --argjson sessions "$(sessions_json)" \
	--argjson users "$(users_json)" --argjson power "$(power_json)" \
	--argjson theme "$(theme_json)" --argjson strings "$(strings_json)" \
	--arg hostname "$(cat /proc/sys/kernel/hostname 2>/dev/null)" \
	--arg lid "$lid" --argjson capsLeds "$caps_leds" --argjson backlights "$backlights" --arg battery "$battery" \
	'{screens: $screens, sessions: $sessions, users: $users, power: $power,
		lid: $lid, capsLeds: $capsLeds, backlights: $backlights, battery: $battery,
		hostname: $hostname, theme: $theme, strings: $strings}' \
	>"$run_dir/env.json"

# Who logged in last and with which session, written at a login: in
# /var/lib/yokoso, which the greeter user must own, and for a preview in the
# runtime directory.
case $mode in
greeter) state=/var/lib/yokoso/state.json ;;
*) state=$run_dir/state.json ;;
esac
export YOKOSO_STATE="${YOKOSO_STATE:-$state}"

export YOKOSO_ENV="$run_dir/env.json" YOKOSO_MODE="$mode"
export QT_QPA_PLATFORM=wayland QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_NO_XDG_DESKTOP_PORTAL=1 QSG_RHI_BACKEND=opengl
unset QT_SCALE_FACTOR QT_SCREEN_SCALE_FACTORS

# Mesa's shader cache and Qt's: a greeter's home is usually read-only
# (/var/empty), so they go to /var/cache/yokoso where that's writable, else
# to the runtime directory until a reboot.
if [ -z "${XDG_CACHE_HOME:-}" ] && ! mkdir -p "${HOME:-/nonexistent}/.cache" 2>/dev/null; then
	if [ -w /var/cache/yokoso ]; then
		export XDG_CACHE_HOME=/var/cache/yokoso
	else
		export XDG_CACHE_HOME="$run_dir/cache"
	fi
fi

# fakegreet binds ./greetd.sock (socket paths are short) and outlives the
# greeter, so the greeter's command ends it.
fake() {
	mkdir -p "$run_dir/fake"
	cd "$run_dir/fake"
	exec fakegreet "$1; kill \$PPID"
}

case $mode in
greeter)
	export WLR_DRM_DEVICES="$drm_devices"
	# greetd leaves the greeter's output on its VT: keep it in the journal
	# (journalctl -t yokoso) where systemd is there.
	log=
	command -v systemd-cat >/dev/null && log="systemd-cat -t yokoso --"
	# Not exec'd, so its failure reaches the fallback; a stop is passed on
	# instead. Its input stays the VT.
	$log cage -s -- quickshell -p "$shell_dir" <&0 &
	cage=$!
	trap 'kill "$cage" 2>/dev/null; wait "$cage" || true; restore_backlight; exit 0' TERM INT HUP
	wait "$cage"
	restore_backlight
	;;
preview)
	fake "quickshell -p '$shell_dir'"
	;;
shot)
	export YOKOSO_SCREENSHOT="${2:?usage: yokoso shot <file.png>}"
	export WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDER_DRM_DEVICE="$render_node"
	unset WAYLAND_DISPLAY DISPLAY NIRI_SOCKET DBUS_SESSION_BUS_ADDRESS
	fake "cage -s -- quickshell -p '$shell_dir'"
	;;
*)
	echo "usage: yokoso [greeter | preview | shot <file.png>]" >&2
	exit 2
	;;
esac
