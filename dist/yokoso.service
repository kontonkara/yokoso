[Unit]
Description=yokoso desktop shell
Documentation=https://github.com/kontonkara/yokoso
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/yokoso shell
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
